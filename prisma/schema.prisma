// Prisma schema — PyPath.
// Provider: PostgreSQL (durable cloud DB for prod; same provider locally via Docker).
// Progress + XP ledger are synced snapshots of the client's local-first
// IndexedDB store (ADR-0004); the client always merges before pushing, and the
// server only ever writes with the session user's identity (never a client-
// supplied userId).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String
  emailVerifiedAt DateTime?
  // Brute-force protection: lockout after repeated failed logins.
  failedLoginCount Int    @default(0)
  lockedUntil      DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress    Progress?
  xpEvents    XpEvent[]
  resetTokens PasswordResetToken[]
  verifyTokens EmailVerifyToken[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per user: the authoritative cloud snapshot of the local progress
/// store. `xp` is NOT stored here — it is always derived from XpEvent rows so
/// re-syncs can never double-award XP.
model Progress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  version          Int     @default(1)
  completedLessons Json    @default("[]")
  exerciseResults  Json    @default("{}")
  notes            Json    @default("{}")
  lessonStarted    Json    @default("{}")
  settings         Json    @default("{}")
  /// Certification/exam/capstone store (separate client store, synced too).
  certification    Json    @default("{}")
  updatedAt        DateTime @updatedAt
}

/// Append-only XP ledger. `(userId, id)` is the client's idempotency key
/// (e.g. "xp:py4e.ch1.l1:ex1:pass") — re-syncs dedupe naturally.
model XpEvent {
  userId String
  id     String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int
  reason String
  ts     DateTime

  createdAt DateTime @default(now())

  @@id([userId, id])
  @@index([userId, ts])
}

/// Password reset — only a SHA-256 hash of the one-time token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Email verification — same hashed-token pattern.
model EmailVerifyToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
