      starterCode: "# ملعبك الحرّ — عائلة الأصناف\n# Your playground — the class family\n\nclass PartyAnimal:\n    def __init__(self, nam):\n        self.name = nam\n        self.x = 0\n\n    def party(self):\n        self.x = self.x + 1\n        print(self.name, 'party', self.x)\n\nclass CricketFan(PartyAnimal):\n    points = 0\n\n    def six(self):\n        self.points = self.points + 6\n        self.party()\n        print(self.name, 'points', self.points)\n\nj = CricketFan('Jim')\nj.party()\nj.six()\n\nprint(type(j))\nprint(isinstance(j, PartyAnimal))\nprint(issubclass(CricketFan, PartyAnimal))\n\n# جرّب: أضف تابع dribble(self) يرفع النقاط واحدًا ويستدعي party\n# try: add a dribble(self) method raising points by one and calling party\n# جرّب: ابنِ p = PartyAnimal('Sally') ثم p.six() — ماذا يرمي؟ ولماذا؟\n# try: build p = PartyAnimal('Sally') then p.six() — what does it throw and why?",
