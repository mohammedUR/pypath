      code: "x = 6\ny = 2\nprint(x >= 2 and (x / y) > 2)   # الحارس صحيح والقسمة تجري\n\nx = 1\ny = 0\nprint(x >= 2 and (x / y) > 2)   # الحارس فشل فأوقف كل شيء\n\nx = 6\ny = 0\ntry:\n    print(x >= 2 and (x / y) > 2)\nexcept:\n    print('ZeroDivisionError — الحارس لم يوقف شيئًا')",
