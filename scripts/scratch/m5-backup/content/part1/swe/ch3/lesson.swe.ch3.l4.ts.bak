import type { Lesson } from '@/lib/content/schema';

/**
 * swe.ch3.l4 — "Clarifying Goals and Security Attacks"
 * توضيح الأهداف وهجمات الأمان
 * Aligned with SWE ch3 s6 (Clarifying User Goals, pp.79-82) +
 * s7 (Identifying Security Attacks, pp.82-85).
 * All expression is original — a paraphrase of the CC BY-SA 4.0 source, never
 * a verbatim translation.
 * Runnable design: (a) a deterministic goal-ladder stepper — a fixed WHY/HOW
 * graph walked up from feature to goal to value and down again; (b) an
 * abuse-case lister — fixed scenarios classified normal/abuse by a MISUSERS
 * actor set, printing per-case verdicts and counts. STRIDE stays a data tag.
 * Deterministic only: no input(), no exit(), no random, no unittest.main.
 */
