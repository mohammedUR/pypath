        { ar: 'للإساءة ألحق الوسم من sc[\'stride\'] بين قوسين: case %d abuse (%s).', en: "For abuse append the tag from sc['stride'] in parentheses: case %d abuse (%s)." },
        { ar: 'الهيكل:\nfor i, sc in enumerate(SCENARIOS, 1):\n    kind = classify(sc)\n    if kind == \'abuse\':\n        abuse += 1\n        print(\'case %d abuse (%s)\' % (i, sc[\'stride\']))\n    else:\n        normal += 1\n        print(\'case %d normal\' % i)\nprint(\'normal: %d abuse: %d\' % (normal, abuse))', en: "The skeleton:\nfor i, sc in enumerate(SCENARIOS, 1):\n    kind = classify(sc)\n    if kind == 'abuse':\n        abuse += 1\n        print('case %d abuse (%s)' % (i, sc['stride']))\n    else:\n        normal += 1\n        print('case %d normal' % i)\nprint('normal: %d abuse: %d' % (normal, abuse))" },
