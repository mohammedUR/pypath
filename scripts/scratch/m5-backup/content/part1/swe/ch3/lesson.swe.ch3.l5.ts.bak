      options: [
        { id: 'a', text: { ar: 'صف القصص الصالحة — عددها يظهر جاهزية الفريق', en: 'The valid-stories row — its count shows team readiness' } },
        { id: 'b', text: { ar: 'جدول الإساءة — كل متطلب أمني مربوط بالهجوم الذي يوقفه، مثل منع إعادة كلمة سر الغير أمام حالة المنتحل', en: 'The abuse table — each security requirement is tied to the attack it stops, like blocking password resets for others against the impostor case' } },
        { id: 'c', text: { ar: 'سطر الحصيلة — الأعداد الكبيرة تقتنع الرعاة', en: 'The tally line — big numbers convince sponsors' } },
