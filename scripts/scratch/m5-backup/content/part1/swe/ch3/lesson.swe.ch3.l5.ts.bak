import type { Lesson } from '@/lib/content/schema';

/**
 * swe.ch3.l5 — "Chapter 3 Review and Project: The Requirements Pack"
 * مراجعة الفصل 3 ومشروع: حزمة المتطلبات
 * Aligned with SWE ch3 s8 (Conclusion, pp.85-86) + the chapter review.
 * All expression is original — a paraphrase of the CC BY-SA 4.0 source, never
 * a verbatim translation.
 * Runnable design: a deterministic mini requirements-kit — the story validator
 * from l3, a Must-first priority tally, and the abuse-case table from l4 over
 * fixed data, printing a compact pack summary. The debug block is a validator
 * with a WRONG rule (prefix-only check) that accepts a malformed story and
 * inflates the Must count — it RUNS and shows the symptom.
 * Deterministic only: no input(), no exit(), no random, no unittest.main.
 */
