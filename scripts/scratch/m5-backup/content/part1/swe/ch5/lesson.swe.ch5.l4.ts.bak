}

def trace(name, indent=""):
    for s in REGISTRY[name]["steps"]:
        if s.startswith("Include "):
            print(indent + "-> include:", s[len("Include "):])
            trace(s[len("Include "):], indent + "  ")
        else:
            print(indent + "-", s)

