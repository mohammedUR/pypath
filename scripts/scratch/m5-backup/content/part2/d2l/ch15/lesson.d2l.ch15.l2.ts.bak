        { ar: 'لا تنسَ أن fastText يضيف دائما مقطعا واحدا خاصا هو الكلمة كاملة <where> إلى جانب المقاطع.', en: 'Do not forget that fastText always adds one special piece, the whole word <where>, alongside the n-grams.' },
        { ar: 'الجواب: 5 مقاطع ثلاثية (<wh وwhe وher وere وre>) + المقطع الخاص = 6.', en: 'Answer: 5 trigrams (<wh, whe, her, ere, re>) + the special piece = 6.' },
