      hints: [
        { ar: 'اقرأ الفهرسين من القاموس نفسه: pad = tok2idx[<pad>] وunk = tok2idx[<unk>] — لا تفترض قيمهما.', en: 'Read both indices from the dict itself: pad = tok2idx[<pad>] and unk = tok2idx[<unk>] — do not hardcode them.' },
        { ar: 'القص أولا: [tok2idx.get(t, unk) for t in tokens][:num_steps] — ثم الحشو بعد ذلك.', en: 'Truncate first: [tok2idx.get(t, unk) for t in tokens][:num_steps] — then pad afterwards.' },
        { ar: 'الحشو: idxs + [pad] * (num_steps - len(idxs)) — يصير صفر خطوات إذا كان الطول مساويا تماما.', en: 'Padding: idxs + [pad] * (num_steps - len(idxs)) — zero copies when the length already matches.' },
        { ar: 'قيم تحقق: مراجعة great إلى الطول 5 تعطي [2, 3, 4, 5, 0]، وfilm المجهولة تصير الفهرس 1.', en: 'Sanity values: the great review to length 5 gives [2, 3, 4, 5, 0], and unknown film becomes index 1.' },
