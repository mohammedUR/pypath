import type { Lesson } from '@/lib/content/schema';

/**
 * d2l.ch16.l1 — "Sentiment Analysis: Dataset, RNN and CNN Routes"
 * تحليل المشاعر: المجموعة وطرقا RNN وCNN
 * Aligned with D2L ch16 s1 (Sentiment Analysis and the Dataset) + s2
 * (Sentiment Analysis: Using Recurrent Neural Networks) + s3 (Sentiment
 * Analysis: Using Convolutional Neural Networks). All expression is original —
 * a paraphrase of the source's ideas, never a verbatim translation. Runnable
 * design: a tiny sentiment vocabulary with pad/truncate encoding of 3 fixed
 * one-line reviews, an RNN-style last-hidden-state classifier with literal
 * weights scored by pure-python softmax, and textCNN window-count math.
 * Every literal verified under CPython 3. Deterministic only.
 */
const lesson = {
  id: 'd2l.ch16.l1',
  version: 1,
  part: 'II',
  track: 'A5',
  book: 'D2L',
  chapter: 16,
  title: {
    ar: 'تحليل المشاعر: المجموعة وطرقا RNN وCNN',
    en: 'Sentiment Analysis: Dataset, RNN and CNN Routes',
  },
  estimatedMinutes: 30,
  prerequisites: ['d2l.ch15.l4'],
  blocks: [
    {
      kind: 'hook',
      text: {
        ar: '«هذا الفيلم رائع» و«هذا الفيلم سيئ» — تصنيف مثل هذه المراجعات هو جوهر تحليل المشاعر: خريطة آراء على المراجعات والتعليقات تتغذى عليها السياسة والتمويل والتسويق. سنبني الخط الكامل على مجموعة IMDb: مفردات، ثم قصّ وحشو إلى طول ثابت، ثم مصنّفان متنافسان — BiRNN يقرأ التسلسل رمزا رمزا وtextCNN يمسحه بنوافذ n-gram — ولكل منهما نسخة دمية صغيرة تعمل فورا بلغة بايثون الخالصة.',
        en: '"This movie is great" and "this movie is bad" — classifying such reviews is the heart of sentiment analysis: an opinion map over reviews and comments that feeds politics, finance, and marketing. We build the full pipeline on the IMDb dataset: vocabulary, then truncation and padding to a fixed length, then two rival classifiers — a BiRNN that reads the sequence token by token and a textCNN that scans it with n-gram windows — each with a tiny toy version that runs instantly in pure Python.',
      },
    },
    {
      kind: 'concept',
      heading: { ar: 'من نص متغيّر الطول إلى فئة ثابتة، بطريقين', en: 'From a varying-length text to a fixed class, two ways' },
      chunks: [
        {
          ar: 'يبحث تحليل المشاعر في الآراء التي يكتبها الناس: مراجعات المنتجات وتعليقات المدونات ونقاشات المنتديات. وهو مهمة تصنيف نصوص تحوّل تسلسلا متغيّر الطول إلى فئة ثابتة، لذلك تخدم السياسة والتمويل والتسويق. يستخدم الكتاب مجموعة Stanford الكبيرة لمراجعات الأفلام: 25000 مراجعة تدريب و25000 اختبار من IMDb بعدد متساوٍ من الأمثلة الموجبة والسالبة، والتسمية 1 للموجب و0 للسالب. الكلمات رموز، وتُبنى المفردات من رموز التدريب بشرط min_freq=5 مع رمز محجوز <pad>. أطوال المراجعات متباينة جدًا، فتُثبّت truncate_pad كل مراجعة عند num_steps=500 فهرسًا: قصّ الأطول وحشو الأقصر. دفعات من 64 صفا بطول ثابت تعطي 391 دفعة تدريب.',
          en: 'Sentiment analysis studies the opinions people write: product reviews, blog comments, forum threads. It is a text-classification task that maps a varying-length sequence to a fixed category, feeding politics, finance, and marketing. The book uses the Stanford large movie review dataset: 25000 training and 25000 test IMDb reviews with equally many positive and negative examples, label 1 for positive and 0 for negative. Words are tokens; a vocabulary is built from training tokens with min_freq=5 and a reserved <pad> token. Review lengths vary wildly, so truncate_pad fixes each review at num_steps=500 indices: cut longer, pad shorter. Batches of 64 fixed-length rows give 391 training batches.',
        },
        {
          ar: 'طريق RNN يحتفظ بالمتجهات المدرَّبة مسبقًا: كل رمز يحمل سطر GloVe ذا 100 بُعد، مجمّدًا أثناء التدريب. LSTM ثنائية الاتجاه بطبقتين تُرمِّز التسلسل، وتُلصق الحالات المخفية للطبقة الأخيرة عند الخطتين الابتدائية والنهائية في تمثيل نص واحد بعرض 4 × num_hiddens، ثم تحوّله طبقة اتصال كامل إلى مخرجين. Adam بمعدل تعلم 0.01 لخمس حقبات يبلغ دقة اختبار 0.861، وpredict_sentiment تقرأ «this movie is so great» كموجب. نسختنا الدمية المصغرة تختزل الفكرة: حالة مخفية ثنائية البعد يحدّثها tanh، ثم رأس ثابت مع softmax.',
          en: 'The RNN route keeps pretrained vectors: each token holds its 100-dimensional GloVe row, frozen during training. A two-layer bidirectional LSTM encodes the sequence, and the hidden states of the last layer at the initial and final time steps are concatenated into one text representation of width 4 x num_hiddens; a fully connected layer maps it to two outputs. Adam with lr 0.01 for 5 epochs reaches 0.861 test accuracy, and predict_sentiment reads this movie is so great as positive. Our toy below compresses the idea: a 2-D hidden state updated by tanh, then a literal head with softmax.',
        },
        {
          ar: 'طريق CNN يعامل النص كصورة أحادية البعد. نواة بعرض k تنزلق فوق n متجه رموز وترى n−k+1 نافذة، وكل قناة مخرجات تُجمّع كاشف n-gram واحد. الارتباط التفافي أحادي البعد متعدد القنوات يعادل الارتباط ثنائي البعد بقناة واحدة إذا ثُبّت ارتفاع النواة على مدخلها. التجميع الأقصى عبر الزمن يأخذ أعلى قيمة لكل قناة، فيساوي طول المتجه المُلصق عدد القنوات الكلي بغض النظر عن طول الجملة. يجمع textCNN طبقتي تضمين (قابلة للتدريب وأخرى ثابتة)، ويشغّل عروض نوافذ 3 و4 و5 بمئة قناة لكل منها، ويبلغ 0.868 دقة اختبار بعد خمس حقبات.',
          en: 'The CNN route treats text as a one-dimensional image. A width-k kernel slides over n token vectors and sees n-k+1 windows; each output channel pools one n-gram detector. Multi-input-channel 1-D cross-correlation equals single-channel 2-D cross-correlation with the kernel height pinned to the input. Max-over-time pooling takes each channel maximum, so the concatenated vector length equals the total number of channels, independent of sentence length. textCNN concatenates two embedding layers (trainable plus constant), runs kernel widths 3, 4, 5 with 100 channels each, and reaches 0.868 test accuracy after 5 epochs.',
        },
      ],
    },
    {
      kind: 'worked',
      title: {
        ar: 'ترميز ثلاث مراجعات + مصنف حالة مخفية + عدّ نوافذ textCNN',
        en: 'Encoding three reviews + a hidden-state classifier + textCNN window counts',
      },
      code: "import math\n\ndef softmax(xs):\n    m = max(xs)\n    es = [math.exp(x - m) for x in xs]\n    s = sum(es)\n    return [e / s for e in es]\n\nVOCAB = ['<pad>', '<unk>', 'this', 'movie', 'is', 'great', 'bad', 'a', 'with', 'acting']\ntok2idx = {t: i for i, t in enumerate(VOCAB)}\n\ndef encode(tokens, num_steps, pad=0, unk=1):\n    idxs = [tok2idx.get(t, unk) for t in tokens][:num_steps]\n    return idxs + [pad] * (num_steps - len(idxs))\n\nreviews = [\n    (['this', 'movie', 'is', 'great'], 1),\n    (['this', 'movie', 'is', 'bad'], 0),\n    (['a', 'great', 'movie', 'with', 'great', 'acting'], 1),\n]\nnum_steps = 5\nencoded = [(encode(t, num_steps), min(len(t), num_steps)) for t, _ in reviews]\nfor (toks, y), (enc, vlen) in zip(reviews, encoded):\n    print('label %d idx %s valid_len %d' % (y, enc, vlen))\n\n# s2: RNN-style classifier: last hidden state -> fixed head -> softmax\nEMB = {'<pad>': [0.0, 0.0], '<unk>': [0.0, 0.0], 'this': [0.1, 0.0],\n       'movie': [0.2, 0.0], 'is': [0.1, 0.0], 'great': [1.0, 0.0],\n       'bad': [-1.0, 0.0], 'a': [0.0, 0.1], 'with': [0.0, 0.2],\n       'acting': [0.5, 0.1]}\nWh, Wr = 0.8, 0.5\nVw = [[-2.0, -1.0], [2.0, 1.0]]  # row 0 = negative, row 1 = positive\n\ndef rnn_last(enc, vlen):\n    h = [0.0, 0.0]\n    for t in range(vlen):\n        e = EMB[VOCAB[enc[t]]]\n        h = [math.tanh(Wh * e[0] + Wr * h[0]), math.tanh(Wh * e[1] + Wr * h[1])]\n    return h\n\nfor (toks, y), (enc, vlen) in zip(reviews, encoded):\n    h = rnn_last(enc, vlen)\n    logits = [Vw[0][0] * h[0] + Vw[0][1] * h[1], Vw[1][0] * h[0] + Vw[1][1] * h[1]]\n    p_pos = softmax(logits)[1]\n    pred = 1 if p_pos > 0.5 else 0\n    print('%s: h=[%.6f, %.6f] p_pos=%.6f pred=%d true=%d'\n          % (' '.join(toks), h[0], h[1], p_pos, pred, y))\n    if y == 1 and vlen < num_steps:\n        h_pad = rnn_last(enc, num_steps)\n        print('after one <pad> step: h=[%.6f, %.6f] (state decays on filler steps)'\n              % (h_pad[0], h_pad[1]))\n\n# s3: textCNN window counts (book figure: 11 tokens, 6-dim vectors)\ndef corr1d(X, K):\n    w = len(K)\n    return [sum(X[i + j] * K[j] for j in range(w)) for i in range(len(X) - w + 1)]\n\nprint('corr1d([0..6], [1, 2]):', corr1d([0, 1, 2, 3, 4, 5, 6], [1, 2]))\nn_tokens = 11\nfor k, c in [(2, 4), (4, 5)]:\n    print('kernel width %d: %d channels, each width %d' % (k, c, n_tokens - k + 1))\nprint('max-over-time pooling -> concat dim', 4 + 5)",
      explanation: {
        ar: 'المفردات العشرية ترمز المراجعات الثلاث إلى [2, 3, 4, 5, 0] و[2, 3, 4, 6, 0] و[7, 5, 3, 8, 5] بأطوال صالحة 4 و4 و5 — الثالثة قُصّت من 6 رموز عند num_steps=5. مصنف RNN: مراجعة great تنتهي بحالة h=[0.710595, 0.000000] فتعطي p_pos=0.944923 (تنبؤ موجب صحيح)، وbad تنتهي بـ h=[-0.611688, 0.000000] وp_pos=0.079676 (تنبؤ سالب صحيح)، والمقصوصة تعطي h=[0.722101, 0.083979] وp_pos=0.955056 — الثلاثة صحيحة. خطوة <pad> واحدة وحدها أسقطت الحالة من 0.710595 إلى 0.341065: خطوات الحشو تُغيّر الحالة الأخيرة. وفي طريق CNN: corr1d على [0..6] بنواة [1, 2] يعطي [2, 5, 8, 11, 14, 17]، ونواة عرضها 2 على 11 رمزا ترى 10 نوافذ وعرضها 4 ترى 8، والتجميع الأقصى يلصق 4 + 5 = 9 قيمة مهما طال النص.',
        en: 'The ten-token vocabulary encodes the three reviews as [2, 3, 4, 5, 0], [2, 3, 4, 6, 0], [7, 5, 3, 8, 5] with valid lengths 4, 4, 5 — the third was truncated from 6 tokens at num_steps=5. The RNN classifier: the great review ends at h=[0.710595, 0.000000] giving p_pos=0.944923 (correct positive), bad ends at h=[-0.611688, 0.000000] with p_pos=0.079676 (correct negative), and the truncated one gives h=[0.722101, 0.083979] with p_pos=0.955056 — all three correct. A single <pad> step alone dropped the state from 0.710595 to 0.341065: filler steps do move the last hidden state. On the CNN route: corr1d over [0..6] with kernel [1, 2] yields [2, 5, 8, 11, 14, 17]; a width-2 kernel over 11 tokens sees 10 windows and width-4 sees 8, and max-over-time pooling concatenates 4 + 5 = 9 values regardless of text length.',
      },
    },
    {
