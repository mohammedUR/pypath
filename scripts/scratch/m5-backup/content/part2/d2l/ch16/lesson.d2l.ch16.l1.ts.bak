      solution: "VOCAB = ['<pad>', '<unk>', 'this', 'movie', 'is', 'great', 'bad', 'a', 'with', 'acting']\ntok2idx = {t: i for i, t in enumerate(VOCAB)}\n\ndef encode_review(tokens, tok2idx, num_steps):\n    pad = tok2idx['<pad>']\n    unk = tok2idx['<unk>']\n    idxs = [tok2idx.get(t, unk) for t in tokens][:num_steps]\n    return idxs + [pad] * (num_steps - len(idxs))\n",
