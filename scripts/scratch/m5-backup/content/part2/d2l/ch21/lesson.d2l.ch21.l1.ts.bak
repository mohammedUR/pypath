import type { Lesson } from '@/lib/content/schema';

/**
 * d2l.ch21.l1 — "Recommender Systems: Collaborative Filtering by Matrix Factorization"
 * أنظمة التوصية: الترشيح التعاوني بتحليل المصفوفات
 * Aligned with D2L ch21 s1 (Overview of Recommender Systems) — the chapter
 * head plus 21.1.1-21.1.3 (collaborative filtering, explicit vs implicit
 * feedback, recommendation tasks). All expression is original — a paraphrase
 * of the source's ideas, never a verbatim translation. Runnable design:
 * matrix factorization of a fixed 4x3 ratings matrix by fixed-iteration SGD
 * (literal init, fixed sweep order, verified losses and predictions), top-1
 * recommendations from predicted scores, and RMSE against a global-mean
 * baseline. Every literal verified under CPython 3. Deterministic only.
 */
