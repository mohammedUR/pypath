        { ar: 'استخدم math.sqrt من الوحدة math — لا ترفع إلى 0.5 يدويا حتى تبقى القراءة واضحة.', en: 'Use math.sqrt from the math module rather than raising to 0.5 manually, for clarity.' },
        { ar: 'في top_k رتّب range(len(scores)) بمفتاح سالب الدرجة ثم خذ أول k: sorted(range(len(scores)), key=lambda i: -scores[i])[:k].', en: 'In top_k sort range(len(scores)) by negated score and slice the first k: sorted(range(len(scores)), key=lambda i: -scores[i])[:k].' },
        { ar: 'قيم تحقق: rmse([0.5, -1.5, 2.0]) = sqrt(6.5/3) ≈ 1.471960، وtop_k([2.1, 4.9, 3.3], 2) = [1, 2].', en: 'Sanity values: rmse([0.5, -1.5, 2.0]) = sqrt(6.5/3) ≈ 1.471960, and top_k([2.1, 4.9, 3.3], 2) = [1, 2].' },
