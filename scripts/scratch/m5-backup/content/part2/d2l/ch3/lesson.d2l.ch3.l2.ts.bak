          code: "u = lcg_stream(0, 3)\nassert abs(u[0] - 0.2360679728) < 1e-9 and abs(u[1] - 0.2785669086) < 1e-9 and abs(u[2] - 0.8195337600) < 1e-9, 'expected ~[0.2361, 0.2786, 0.8195] | actual: %r' % (u,)",
          expected: '[0.2361, 0.2786, 0.8195]',
