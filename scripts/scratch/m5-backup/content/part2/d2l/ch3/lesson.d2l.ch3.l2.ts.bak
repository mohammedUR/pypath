    {
      kind: 'sandbox',
      starterCode: "def lcg(seed):\n    state = seed\n    while True:\n        state = (1664525 * state + 1013904223) % 4294967296\n        yield state / 4294967296.0\n\ndef synth_data(n, w_true, b_true, noise, seed):\n    gen = lcg(seed)\n    X, y = [], []\n    for _ in range(n):\n        x1 = next(gen) * 2 - 1\n        x2 = next(gen) * 2 - 1\n        X.append([x1, x2])\n        y.append(w_true[0] * x1 + w_true[1] * x2 + b_true + next(gen) * noise * 2 - noise)\n    return X, y\n\nX, y = synth_data(64, [2.0, -3.4], 4.2, 0.01, 7)\n\ndef train(epochs, lr, batch):\n    w, bias = [0.0, 0.0], 0.0\n    for _ in range(epochs):\n        for s in range(0, len(X), batch):\n            idx = range(s, min(s + batch, len(X)))\n            errs = [sum(w[j] * X[i][j] for j in range(2)) + bias - y[i] for i in idx]\n            gw = [sum(X[i][j] * errs[k] for k, i in enumerate(idx)) / len(idx) for j in range(2)]\n            gb = sum(errs) / len(idx)\n            w = [w[j] - lr * gw[j] for j in range(2)]\n            bias -= lr * gb\n    return w, bias\n\nfor lr in (0.05, 0.1, 0.3):\n    w, bias = train(20, lr, 16)\n    print('lr=%.2f -> w=[%.4f, %.4f] b=%.4f' % (lr, w[0], w[1], bias))\n\n# جرّب: بدّل seed ولاحظ أن التقديرات تختلف قليلاً — الضوضاء والدفعات يتغيران.\n# try: change the seed and watch the estimates move slightly — noise and batches shift.\n# جرّب: ارفع noise إلى 1.0 وشاهد كيف يتسع خطأ الاسترجاع.\n# try: raise noise to 1.0 and watch the recovery error widen.\n",
