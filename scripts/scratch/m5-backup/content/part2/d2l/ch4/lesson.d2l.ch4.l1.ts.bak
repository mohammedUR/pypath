import type { Lesson } from '@/lib/content/schema';

/**
 * d2l.ch4.l1 — "Softmax Regression and the Image Dataset"
 * انحدار softmax ومجموعة الصور
 * Aligned with D2L ch4 s1 (Softmax Regression) + s2 (The Image Classification
 * Dataset). All expression is original — a paraphrase of the source's ideas,
 * never a verbatim translation. Runnable design: numerically stable softmax
 * (max subtraction), one-hot encoding, cross-entropy by indexing, accuracy,
 * and the softmax−y gradient identity. Every printed literal verified under
 * CPython 3. Deterministic only.
 */
const lesson = {
  id: 'd2l.ch4.l1',
  version: 1,
