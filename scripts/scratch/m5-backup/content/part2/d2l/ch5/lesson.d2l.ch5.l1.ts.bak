      starterCode: "import math\n\ndef relu(v):\n    return [max(0.0, x) for x in v]\n\ndef sigmoid(v):\n    return 1.0 / (1.0 + math.exp(-v))\n\n# derivative check: sigmoid'(x) = s(x)*(1-s(x)) <= 0.25\nfor v in (-4.0, -1.0, 0.0, 1.0, 4.0):\n    s = sigmoid(v)\n    print('x=%5.1f sigmoid=%.4f grad=%.4f' % (v, s, s * (1 - s)))\n\n# a 2-2-1 net with sigmoid hidden units\nW1 = [[1.0, -1.0], [0.5, 2.0]]\nb1 = [0.0, 1.0]\nW2 = [1.0, 3.0]\nb2 = -1.0\nfor x in ([2.0, 1.0], [0.0, -2.0]):\n    z = [sum(x[i] * W1[i][j] for i in range(2)) + b1[j] for j in range(2)]\n    h = [sigmoid(v) for v in z]\n    o = sum(h[i] * W2[i] for i in range(2)) + b2\n    print('x=%s z=%s h(sig)=%s o=%.4f' % (x, z, ['%.4f' % v for v in h], o))\n\n# جرّب: بدّل sigmoid بـ relu في نفس الشبكة وقارن المخرجات — أيهما يتشبع؟\n# try: swap sigmoid for relu in the same net and compare outputs — which one saturates?\n# جرّب: اضرب W2 في 10 وأعد التمرير: هل تتفاقم مشكلة التشبع مع الأوزان الكبيرة؟\n# try: multiply W2 by 10 and rerun: does saturation worsen with larger weights?\n",
