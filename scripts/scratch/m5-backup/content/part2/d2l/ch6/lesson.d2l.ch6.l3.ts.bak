      hints: [
        { ar: 'المتوسط: m = sum(x) / len(x) ثم قائمة متركزة [v - m for v in x].', en: 'The mean: m = sum(x) / len(x), then a centered list [v - m for v in x].' },
        { ar: 'ابنِ القاموس بفهم قاموسي: {l.label: {"w": l.w, "b": l.b} for l in layers} ثم json.dumps ثم json.loads.', en: 'Build the dict with a comprehension: {l.label: {"w": l.w, "b": l.b} for l in layers}, then json.dumps, then json.loads.' },
        { ar: 'json.dumps/loads يحافظان على القوائم والأرقام كما هي — القاموس المعاد يجب أن يساوي الأصلي تمامًا.', en: 'json.dumps/loads preserve lists and numbers exactly — the loaded dict must equal the original.' },
        { ar: 'قيم تحقق: forward([[1,-1],[2,0.5]], [0.25,-0.75], [2,1]) = [1.25, 3.75] — صف بصف: 2−1+0.25 و4+0.5−0.75.', en: 'Sanity: forward([[1,-1],[2,0.5]], [0.25,-0.75], [2,1]) = [1.25, 3.75] — row by row: 2\u22121+0.25 and 4+0.5\u22120.75.' },
      ],
    },
    {
      kind: 'exercise',
      id: 'ex2.mcq-gpu-same-device',
      exKind: 'mcq',
      required: true,
      prompt: {
        ar: 'الموتر X يسكن cuda:0 والموتر Y يسكن cuda:1، وكتبت X + Y. ماذا يحدث؟',
