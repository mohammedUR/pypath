c1 = [5.0, 7.0, 9.0]
mu0, mu1 = 2.0, 7.0
var0, var1 = 2.0 / 3.0, 8.0 / 3.0
pi0 = pi1 = 0.5

x = 4.0
like0 = pi0 * gaussian_pdf(x, mu0, var0)
like1 = pi1 * gaussian_pdf(x, mu1, var1)
print(f"density*prior class 0 = {like0:.4f}")
print(f"density*prior class 1 = {like1:.4f}")
print("pick:", 0 if like0 > like1 else 1)
print("same as qda?", (0 if like0 > like1 else 1) == 1)`,
