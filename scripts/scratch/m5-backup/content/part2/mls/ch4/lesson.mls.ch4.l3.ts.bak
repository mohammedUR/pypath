      solution: `import math

def gaussian_pdf(x, mu, var):
    return math.exp(-(x - mu) ** 2 / (2 * var)) / math.sqrt(2 * math.pi * var)

print(f"pdf(2, 2, 1) = {gaussian_pdf(2.0, 2.0, 1.0):.4f}")
print(f"pdf(0, 0, 2) = {gaussian_pdf(0.0, 0.0, 2.0):.4f}")
sym = abs(gaussian_pdf(4.0, 2.0, 1.0) - gaussian_pdf(0.0, 2.0, 1.0)) < 1e-12
print("symmetric:", sym)`,
