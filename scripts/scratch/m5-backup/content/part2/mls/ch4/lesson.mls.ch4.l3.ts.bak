def lda_score(x, pi, mu):
    return 0.0  # TODO: log(pi) - (x - mu)^2 / (2*var)

def lda_predict(xs):
    # TODO: class 0 when its score ties or wins, else class 1
    return [0 for _ in xs]

print(f"mu: {mu0}, {mu1} | shared var = {var:.4f}")
print("preds =", lda_predict([4.0, 6.0, 2.0, 8.0]))
print("train preds =", lda_predict(c0 + c1))`,
      solution: `import math

c0 = [1.0, 2.0, 3.0]
c1 = [5.0, 7.0, 9.0]
n0, n1 = len(c0), len(c1)
mu0, mu1 = sum(c0) / n0, sum(c1) / n1
var = (sum((x - mu0) ** 2 for x in c0) + sum((x - mu1) ** 2 for x in c1)) / (n0 + n1)
pi0 = pi1 = 0.5

def lda_score(x, pi, mu):
    return math.log(pi) - (x - mu) ** 2 / (2 * var)

def lda_predict(xs):
    return [0 if lda_score(x, pi0, mu0) >= lda_score(x, pi1, mu1) else 1 for x in xs]

print(f"mu: {mu0}, {mu1} | shared var = {var:.4f}")
print("preds =", lda_predict([4.0, 6.0, 2.0, 8.0]))
print("train preds =", lda_predict(c0 + c1))`,
