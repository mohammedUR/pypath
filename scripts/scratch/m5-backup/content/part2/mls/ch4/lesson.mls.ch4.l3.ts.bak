        en: 'Implement nb_predict(counts) on the ready count model: for each class sum log(prior) plus counts[d]*log(P[label][word]) over the words, and return the higher-scoring label. The three messages in the fixed lines must sort to spam, ham, and spam.',
      },
      starterCode: `import math

P = {
    "spam": {"free": 5 / 12, "meeting": 2 / 12, "money": 5 / 12},
    "ham": {"free": 2 / 10, "meeting": 6 / 10, "money": 2 / 10},
}
PRIOR = {"spam": 0.5, "ham": 0.5}
WORDS = ["free", "meeting", "money"]

def nb_predict(counts):
    # TODO: for each class sum log(prior) + counts[d]*log(P[label][word]);
    # return the label with the larger total.
    return "ham"

print("doc A [1, 0, 1] ->", nb_predict([1, 0, 1]))
print("doc B [0, 2, 0] ->", nb_predict([0, 2, 0]))
print("doc C [0, 0, 3] ->", nb_predict([0, 0, 3]))`,
      solution: `import math

P = {
    "spam": {"free": 5 / 12, "meeting": 2 / 12, "money": 5 / 12},
    "ham": {"free": 2 / 10, "meeting": 6 / 10, "money": 2 / 10},
}
PRIOR = {"spam": 0.5, "ham": 0.5}
WORDS = ["free", "meeting", "money"]

def nb_predict(counts):
    best, best_score = None, None
    for label in ("spam", "ham"):
        s = math.log(PRIOR[label])
        for d, word in enumerate(WORDS):
            s += counts[d] * math.log(P[label][word])
        if best_score is None or s > best_score:
            best, best_score = label, s
    return best

print("doc A [1, 0, 1] ->", nb_predict([1, 0, 1]))
print("doc B [0, 2, 0] ->", nb_predict([0, 2, 0]))
print("doc C [0, 0, 3] ->", nb_predict([0, 0, 3]))`,
      tests: [
        {
          id: 't1',
          name: { ar: 'الرسالة الأولى مزعجة', en: 'first message is spam' },
          code: `assert nb_predict([1, 0, 1]) == "spam", 'expected spam | actual: %r' % nb_predict([1, 0, 1])`,
        },
        {
          id: 't2',
          name: { ar: 'الرسالة الثانية عادية', en: 'second message is ham' },
          code: `assert nb_predict([0, 2, 0]) == "ham", 'expected ham | actual: %r' % nb_predict([0, 2, 0])`,
        },
        {
          id: 't3',
          name: { ar: 'رسالة المال الصافية', en: 'the pure-money message' },
          code: `assert nb_predict([0, 0, 3]) == "spam", 'expected spam | actual: %r' % nb_predict([0, 0, 3])\nassert 'doc C [0, 0, 3] -> spam' in __learner_output__, 'expected line: doc C [0, 0, 3] -> spam | actual: %r' % __learner_output__`,
        },
      ],
      hints: [
        { ar: 'ابدأ best = None وbest_score = None، وفي كل صنف احسب s = math.log(PRIOR[label]) ثم أضف حدود الكلمات.', en: 'Start with best = None and best_score = None; for each class compute s = math.log(PRIOR[label]) then add the word terms.' },
        { ar: 'حد الكلمة: s += counts[d] * math.log(P[label][word]) — العدّ يضاعف الدليل.', en: 'Word term: s += counts[d] * math.log(P[label][word]) — the count multiplies the evidence.' },
        { ar: 'التحديث: if best_score is None or s > best_score — خزّن الصنف ودرجته معًا.', en: 'The update: if best_score is None or s > best_score — store the label and its score together.' },
        { ar: 'النتيجة: doc A -> spam وdoc B -> ham وdoc C -> spam.', en: 'The result: doc A -> spam, doc B -> ham, doc C -> spam.' },
      ],
