        { ar: 'المرشحون: [(a + b) / 2 for a, b in zip(sorted(set(xs)), sorted(set(xs))[1:])].', en: 'The candidates: [(a + b) / 2 for a, b in zip(sorted(set(xs)), sorted(set(xs))[1:])].' },
