import type { Lesson } from '@/lib/content/schema';

/**
 * mls.ch7.l1 — "Neural Networks: Neurons, Layers, and the Forward Pass"
 * الشبكات العصبية: العصبونات والطبقات والتمرير الأمامي
 * Aligned with MLS ch7 s1 (Concept). All expression is original — a paraphrase
 * of the source's ideas, never a verbatim translation.
 * Runnable design: hand-written 2-8-1 network as literal weight lists; pure
 * loop forward pass printing every neuron's pre-activation and ReLU output.
 * Deterministic only: no input(), no exit(), no LCG needed here.
 */
const lesson = {
  id: 'mls.ch7.l1',
  version: 1,
  part: 'II',
