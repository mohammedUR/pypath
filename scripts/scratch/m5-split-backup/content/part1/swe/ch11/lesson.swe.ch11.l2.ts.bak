import type { Lesson } from '@/lib/content/schema';

/**
 * swe.ch11.l2 — "Finding Vulnerabilities: from Manual Review to Autonomous Agents
 * البحث عن الثغرات: من الفحص اليدوي إلى المستقل"
 * Aligned with SWE ch11 s3 (Finding Vulnerabilities, from Manual to Autonomous,
 * pp.293-295).
 * All expression is original — a paraphrase of the CC BY-SA 4.0 source, never
 * a verbatim translation.
 * Runnable design: a mini security linter over EMBEDDED source strings using
 * ast (eval/exec deny-list, SQL built by string concatenation, bare except)
 * plus a deterministic fuzz loop over a FIXED candidate list. Deterministic
 * by construction: nothing interactive, nothing unpredictable, no process
 * spawning, no network access.
 */

