            { id: 'b', text: { ar: 'السرعة: أبلغ عن الثغرة فورًا علنًا قبل أن يستغلها غيرك', en: 'Speed: disclose the finding publicly at once before others exploit it' } },
            { id: 'c', text: { ar: 'العمق: أوقف الوكلاء وأعد الفحص يدويًّا فقط', en: 'Depth: stop the agents and redo everything by hand' } },
