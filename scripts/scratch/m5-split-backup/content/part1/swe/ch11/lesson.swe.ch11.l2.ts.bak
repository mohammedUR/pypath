          code: "assert fuzz(first_word, CANDIDATES) == 2, 'expected: 2 | actual: %r' % fuzz(first_word, CANDIDATES)",
          expected: '2',
        },
        {
          id: 't2',
          name: { ar: 'التقرير يطبع عدد الانهيارات', en: 'The report prints the crash count' },
          code: "assert 'crashes: 2' in __learner_output__, 'expected: crashes: 2 | actual: %r' % __learner_output__",
          expected: 'crashes: 2',
        },
        {
          id: 't3',
          name: { ar: 'قائمة نظيفة تعطي صفر — لا إنذارات كاذبة', en: 'A clean list gives zero — no false positives' },
          code: "assert fuzz(first_word, ['ok', 'also ok']) == 0, 'expected: 0 | actual: %r' % fuzz(first_word, ['ok', 'also ok'])",
          expected: '0',
        },
        {
          id: 't4',
          name: { ar: 'التقرير يطبع عدد المرشحين', en: 'The report prints the candidate count' },
          code: "assert 'candidates: 5' in __learner_output__, 'expected: candidates: 5 | actual: %r' % __learner_output__",
