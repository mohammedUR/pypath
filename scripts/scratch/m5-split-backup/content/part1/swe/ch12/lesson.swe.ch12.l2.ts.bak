      items: [
        {
          wrong: 'قصّ المحور ليبدو التحسن أبهى — «الشكل نفسه، فقط مكبَّر»',
          right: 'أعمدة من الصفر دائمًا؛ إن أردت التكبير فاعرض جدولًا رقميًا بجانب الرسم',
