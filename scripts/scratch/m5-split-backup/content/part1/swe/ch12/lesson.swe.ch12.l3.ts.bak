          name: { ar: 'قيمة escape المجمعة مطابقة للصيغة', en: 'The pooled escape matches the formula' },
          code: "assert abs(escape - 100.0 * 115 / 1300) < 1e-9, 'expected: escape == 100*115/1300 (8.846...) | actual: %r' % (escape,)",
          expected: 'escape == 100*115/1300 (8.846...)',
        },
      ],
      hints: [
        { ar: 'داخل الحلقة d = releases[k] قاموس صغير — الدخول بمفاتيح السلاسل: d[\'before\'] وd[\'prod\'].', en: "Inside the loop d = releases[k] is a small dict — access it with string keys: d['before'] and d['prod']." },
        { ar: 'صيغة DRE كما في الشارح: 100.0 * d[\'before\'] / (d[\'before\'] + d[\'prod\']) — المقام مجموع الاثنين لا before وحدها.', en: "The DRE formula from the worked example: 100.0 * d['before'] / (d['before'] + d['prod']) — the denominator is the sum of both, not before alone." },
        { ar: 'لا تنسَ التجزئة داخل الحلقة: sum_before += d[\'before\'] وsum_prod += d[\'prod\'] — وإلا صار pooled escape: 0.0%.', en: "Do not forget accumulation inside the loop: sum_before += d['before'] and sum_prod += d['prod'] — otherwise the line reads pooled escape: 0.0%." },
        { ar: 'الحل:\nfor k in releases:\n    d = releases[k]\n    dre = 100.0 * d[\'before\'] / (d[\'before\'] + d[\'prod\'])\n    print(\'%s DRE: %.1f%%\' % (k, dre))\n    sum_before += d[\'before\']\n    sum_prod += d[\'prod\']', en: "The fix:\nfor k in releases:\n    d = releases[k]\n    dre = 100.0 * d['before'] / (d['before'] + d['prod'])\n    print('%s DRE: %.1f%%' % (k, dre))\n    sum_before += d['before']\n    sum_prod += d['prod']" },
