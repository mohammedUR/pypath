          code: "assert abs(upper_fence - 22.5) < 1e-9 and outliers == [23], 'expected: upper fence 22.5 and outliers [23] | actual: %r' % ((upper_fence, outliers),)",
          expected: 'upper fence 22.5 and outliers [23]',
