        { ar: 'والانحراف المعياري جذر الناتج: √34.2 ≈ 5.85 — بوحدات العيوب نفسها.', en: 'The standard deviation is its square root: √34.2 ≈ 5.85 — back in defect units.' },
        { ar: 'الجواب: 34.2', en: 'Answer: 34.2' },
