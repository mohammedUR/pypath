    {
      kind: 'sandbox',
      starterCode: "# ملعبك الحرّ — نموذج Git المصغّر بين يديك\n# Your playground — the Mini-Git model in your hands\n\nclass MiniGit:\n    def __init__(self):\n        self.commits = {}\n        self.branches = {'main': None}\n        self.head = 'main'\n        self.files = {}\n        self.next_id = 1\n\n    def change(self, fname, version):\n        self.files[fname] = version\n\n    def commit(self, msg):\n        cid = 'c%d' % self.next_id\n        self.next_id = self.next_id + 1\n        self.commits[cid] = {'id': cid, 'parent': self.branches[self.head], 'msg': msg, 'files': dict(self.files)}\n        self.branches[self.head] = cid\n        return cid\n\n    def branch(self, name):\n        self.branches[name] = self.branches[self.head]\n\n    def checkout(self, name):\n        self.head = name\n        tip = self.branches[name]\n        if tip is not None:\n            self.files = dict(self.commits[tip]['files'])\n\n\ng = MiniGit()\ng.change('app.py', 'v1')\nprint(g.commit('Add app'))\ng.branch('dev')\ng.checkout('dev')\ng.change('idea.py', 'v1')\nprint(g.commit('Spike an idea'))\ng.checkout('main')\nprint(g.commits[g.branches['main']]['msg'])\nprint(g.commits[g.branches['dev']]['msg'])\n\n# جرّب: أضف تابع log(self) يمشي parents من طرف الفرع الحالي ويطبع الأسطر\n# try: add a log(self) method walking parents from the current branch tip\n# جرّب: ابنِ فرعًا ثانيًا وتتبّع يدويًّا أي التزامات يرى كل فرع قبل التشغيل\n# try: build a second branch and trace by hand which commits each branch sees\n# جرّب: أضف تابع tag(self, name, cid) يجمع أسماء الإصدارات في قاموس self.tags\n# try: add a tag(self, name, cid) method collecting release names in a self.tags dict",
      prompt: {
        ar: 'جرّب بنفسك: اكتب log يمشي parents ويطبع السجل، ثم تفرّع من التزام قديم ولاحظ أي التزامات يرى كل فرع — وتتبّع يدويًّا قبل التشغيل. ثم فكّر في tag كقاموس ثالث: الإصدارات المسلَّمة أسماء تعود إليها. لا اختبار هنا — فضولك فقط.',
        en: 'Try it yourself: write a log walking parents and printing history, then branch from an older commit and watch which commits each branch sees — trace by hand before running. Then think of tag as a third dict: shipped releases are names you can return to. No tests here — just your curiosity.',
      },
    },
    {
      kind: 'quiz',
