          code: "g2 = MiniGit()\ng2.change('a.txt', 'v1')\ng2.commit('one')\ng2.branch('dev')\ng2.checkout('dev')\ng2.change('b.txt', 'v1')\ng2.commit('two')\ng2.checkout('main')\nresult = g2.merge('dev')\nassert result == 'fast-forward', 'expected: fast-forward | actual: %r' % result\nassert g2.branches['main'] == 'c2', 'expected: c2 | actual: %r' % g2.branches['main']\nassert g2.files['b.txt'] == 'v1', 'expected: v1 | actual: %r' % g2.files['b.txt']",
          expected: 'fast-forward then c2 with b.txt v1',
        },
        {
          id: 't5',
          name: { ar: 'التعارض يُقرأ من اللقطات لا من شجرة العمل', en: 'The conflict is read from snapshots, not the working tree' },
          code: "g3 = MiniGit()\ng3.change('x.py', 'base')\ng3.commit('base')\ng3.branch('dev')\ng3.change('z.py', 'main')\ng3.commit('main side')\ng3.checkout('dev')\ng3.change('y.py', 'dev')\ng3.commit('dev side')\ng3.checkout('main')\nresult = g3.merge('dev')\nassert result == 'merged', 'expected: merged | actual: %r' % result",
          expected: 'merged when the changed sets do not overlap',
        },
