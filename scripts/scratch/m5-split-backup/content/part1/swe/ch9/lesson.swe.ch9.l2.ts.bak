/**
 * swe.ch9.l2 — "Code Reviews: Intent and Trust /
 * مراجعات الكود: النية والثقة"
 * Aligned with SWE ch9 s3 (9.3 Code Reviews: Check Intent and Trust,
 * pp.238–240).
 * All expression is original (paraphrase of CC BY-SA 4.0 book text).
 * The write_code exercise is a review-comment classifier (startswith/endswith
 * rules + dict counters — py4e ch6 strings, ch4 functions, ch9 dicts), plus a
 * trace of the rule table, a small-changes numeric, and a nit-vs-blocking mcq.
 */
const lesson = {
  id: 'swe.ch9.l2',
  version: 1,
  part: 'I',
  track: 'P3',
  book: 'SWE',
  chapter: 9,
  title: { ar: 'مراجعات الكود: النية والثقة', en: 'Code Reviews: Intent and Trust' },
  estimatedMinutes: 25,
  prerequisites: ['swe.ch9.l1'],
  blocks: [
    {
      kind: 'hook',
      text: {
        ar: 'التنقيح الرسمي ثقيل الكلفة، ولا يفحص به معظم الفرق إلا أخطر موادها. ما يفعله كل فريق محترف تقريبًا على كل تغيير تقريبًا هو نسخته الخفيفة: مراجعة الكود code review — قبل دمج أي تغيير يقرأه مهندس واحد على الأقل غير مؤلفه ويوافق عليه. وبعد أن تعلمت في الدرس الماضي عائلة الفحص الثابت كاملة، هذا هو وجهها اليومي في الصناعة. لكن انتبه: المراجعة الحديثة عبر pull requests ليست صيدًا لكل عيب — الأدوات الآلية (الدرس القادم) أسرع منك في الميكانيكي — بل سؤالان إنسانيان لا أداة تحسمهما: النية والثقة. وستبني اليوم مصغّرًا آليًا من عالم المراجعة نفسها: مصنّف تعليقات يفرز nit من blocking من question بقواعد بسيطة. بنهاية الدرس ستكون قادرًا على: شرح سؤالي النية والثقة ودور المراجع ضامنًا بالتغيير، وتطبيق مبدأ وصاية المستودع على تعليقات مراجعة حقيقية، وتفسير لماذا تُراجع التغييرات خلال ساعات لا أيام ولماذا التغييرات الصغيرة شرط ذلك، وكتابة مصنّف قواعد لتعليقات المراجعة بلغة بايثون.',
        en: 'Full Fagan inspection is heavyweight, so most teams reserve it for the riskiest material. What virtually every professional team does on nearly every change is its lightweight descendant: the code review — before a change is merged, at least one engineer other than the author reads it and must approve it. Having met the whole static-checking family last lesson, this is its daily industrial face. But note: modern review through pull requests is not about hunting every defect — automated tools (next lesson) beat you at the mechanical ones — it is about two human questions no tool can settle: intent and trust. Today you also build a small automated piece of the review world itself: a comment classifier that sorts nit from blocking from question by simple rules. By the end of this lesson you will be able to: explain the intent and trust questions and the reviewer\u2019s role as voucher for a change; apply repository stewardship to real review comments; explain why reviews happen within hours not days and why small changes are the precondition; and write a rule-based classifier for review comments in Python.',
      },
    },
    {
      kind: 'predict',
      code: "comment = 'nit: add a space after the comma'\nprint(comment.startswith('nit:'))\nprint('blocking' in comment)",
      question: {
        ar: 'سطرا فحص من صندوق أدوات السلاسل القديم. في عالم المراجعة: ما الكلمة الوحيدة في بداية التعليق التي تفصل اقتراحًا شكليًا يمكن تجاهله عن عيب يوقف الدمج؟ ومتى يكون الفصل بينهما مصيرياً؟',
        en: 'Two checks from the old string toolbox. In the review world: what single word at the start of a comment separates a style suggestion you may ignore from a defect that stops the merge? And when does drawing that line become decisive?',
      },
      reveal: {
        ar: "True ثم False — فالتعليق يبدأ بـ nit: ولا يحوي كلمة blocking. اتفاق الفريق على بادئة nit: هو عقد مصغر: «ملاحظة صغيرة، الإصلاح فيها اختياري، ولا تمنع الدمج». وبدونه يمزج المراجعون الشكلي بالجوهري فيتعطل التغيير على فاصلة ناقصة. وستبرمج هذا العقد حرفيًا في التمرين الأول.",
        en: "True then False — the comment starts with nit: and contains no blocking. A team agreeing on the nit: prefix is a micro-contract: \u201cminor remark, fixing it optional, merge not blocked.\u201d Without it reviewers mix style with substance and a change stalls over a missing space. You will code exactly this contract in the first exercise.",
      },
    },
    {
      kind: 'concept',
      heading: { ar: 'النية والثقة: السؤالان اللذان لا أداة تحسمهما', en: 'Intent and trust: the two questions no tool settles' },
      chunks: [
        {
          ar: 'النية intent: هل يفعل هذا التغيير ما قصده مؤلفه فعلًا؟ وهل ما قصده هو الصواب أصلاً؟ مراجع يفهم النظام يرى ما لا يراه التغيير نفسه: تغيير صحيح تقنيًا يحل المسألة الخطأ، أو يكسر اتساقًا خفيًا مع بقية الشيفرة. أما الثقة trust فهي المكافأة الثقافية: المراجعة هي كيف يتحمل الفريق مسؤولية مستودعه جماعيًا. بعد الموافقة والدمج لم تعد الشيفرة «شيفرةك» أنت — صارت شيفرة الفريق، والمراجع الذي وافق عليها كفلها. ومن هنا يتضح سبب فساد عادتين: «سي catches المراجع خطئي» تفرغ المؤلف من مسؤوليته، و«أوافق فقط لفتح الطريق له» تفريغ للضمانة من طرف المراجع. الاثنان يهزمان المسؤولية المشتركة التي هي غاية المراجعة كلها.',
          en: 'Intent: does this change do what its author meant it to do — and is what they meant actually right? A reviewer who understands the system sees what the change itself cannot: technically correct code solving the wrong problem, or quietly breaking consistency with the rest of the codebase. Trust is the cultural payoff: code review is how a team collectively takes responsibility for its repository. Once approved and merged, the change is no longer \u201cyours\u201d — it is the team\u2019s, and the reviewer who approved it has vouched for it. That is why two habits are corrosive: \u201cthe reviewer will catch my mistakes\u201d empties the author of responsibility, and \u201cI\u2019m just approving to unblock them\u201d empties the voucher from the reviewer\u2019s side. Both defeat the shared ownership review exists to build.',
        },
        {
          ar: 'والسؤال الحاكم في كل تعليق مراجعة ليس «هل كنت أكتبه هكذا؟» بل «هل سيجعل هذا التغيير المستودع أصح مع الوقت؟» — هذا مبدأ وصاية المستودع repository stewardship. المراجع يرصد المخاطر ويصون المعايير دون فرض أذواقه الشخصية، والتغيير الواضح التحسين يوافق عليه حتى لو تخيل المراجع نسخة أفضل بهامش ضئيل. ويشمل الصحة ما وراء أسطر الفرق: إضافة اختبار ناقص، وتوضيح توثيق مجاور، وتحسين اسم مضلل، وإزالة تكرار، وتقوية الأتمتة. لكن التحسين يبقى مناسب الحجم ومتصل العمل — لا تقلب إصلاح ميزة مركزًا في إعادة كتابة غير مرتبطة؛ والتنظيف الكبير أو الخطِر أو المنفصل يسجل ويقدم تغييرًا صغيرًا مستقلًا.',
          en: 'The governing question in every review comment is not \u201cis this how I would have written it?\u201d but \u201cwill this change make the repository healthier over time?\u201d — repository stewardship. Reviewers identify risks and maintain standards without imposing personal preferences, and a change that clearly improves the system is approved even when the reviewer can imagine a marginally better version. Health extends beyond the diff: adding a missing test, clarifying nearby documentation, improving a misleading name, removing duplication, strengthening the automation that verifies the code. But the improvement stays relevant and proportionate — do not turn a focused fix into an unrelated rewrite; when cleanup is large, risky or separable, record it and submit it as its own small change.',
        },
      ],
    },
    {
      kind: 'concept',
      heading: { ar: 'مراجع مستثمر وساعات لا أيام', en: 'Invested experts, and hours not days' },
      chunks: [
        {
          ar: 'ليست كل المراجعات متكافئة، والفرق ليس المهارة الخام بل الاستثمار والسياق. أنفس مراجع للتغيير هو من يعرف هذه الجزئية بعمق ولهم فيها رهان طويل: من سيصونها، ومن لسعت خطأها الأخير، ومن يحفظ الاتفاقات غير المكتوبة. فهو يجلب ما ليس في الفرق diff: تاريخ شكل الشيفرة، والفشل الذي وجد له شرط غريب حارساً، وخطة المستقبل لهذه الوحدة. لهذا تُسند المراجعات بعناية: تغيير في منظومة الاستيثاق يراجعه من يفهم نموذج الأمن لا من صادف أنه حر. وتشيّد فرق كثيرة ذلك بترميز ملكية الشيفرة code ownership: ملفات وأدلة لها مالكوها الذي تطلب موافقتهم — ضمانًا بأن خبيرًا مستثمرًا يرى كل تغيير في الشيفرة الحساسة. وإن لم تملك أنت السياق لتقييم تغيير، فالتحرك الصادق أن تقول ذلك وتحيله لمن يملك — الموافقة ممن لم يفهم تمنح ثقة ليست حقيقية، وهي أسوأ من لا موافقة.',
          en: 'Not all reviews are equal, and the difference is not raw skill — it is investment and context. The most valuable reviewer for a change knows that part of the system deeply and has a stake in its long-term health: the person who will maintain it, who was burned by its last bug, who holds the unwritten invariants. They bring what is not in the diff: the history of why the code is shaped this way, the failure a strange guard clause exists to prevent, where the module is heading. So reviews are assigned deliberately: a change to the authentication system goes to someone who understands the security model, not whoever is free. Many teams encode this as code ownership: files and directories have designated owners whose approval is required — guaranteeing an invested expert sees every change to sensitive code. And if you lack the context to judge a change, the honest move is to say so and route it to someone who can — an approval from someone who did not understand provides trust that is not real, which is worse than no approval.',
        },
        {
          ar: 'ثم الزمن: تستجيب الفرق الحديثة خلال ساعات لا أيام. حين يجلس التغيير دون مراجعة أيامًا يحدث ثلاث سوءات: المؤلف المحجوب ينتقل لعمل آخر فيدفع كلفة العودة الذهنية، أو — والأسوأ — يبني تغييرات جديدة فوق غير المراجع فتتسلسل مشكلة التغيير الأول فيما بعده؛ والتغيير نفسه يطير عن موعده مع تحرك الشيفرة تحته فتنشأ تعارضات دمج؛ وتتلاشى ذاكرة المؤلف عن سبب كل قرار فتصير ردوده على التعليقات أضمد. والسرعة لا تعني الاستعجال المهمل: ما يجمع بين السرعة والدقة هو التغييرات الصغيرة — تغيير من خمسين سطرًا يُعطى قراءة جادة في دقائق ويُدار في يومه، أما الألفان فلا تُراجع جيدًا ولا سريعًا: يقلبها المراجع قلقًا ويوافق من باب الإنهاك وتصير المراجعة مسرحًا. تغييرات صغيرة تُراجع كثيرًا: هذه الآلية نفسها — أحفظ القطعة صغيرة وأبقِ المراجع منتبهًا — هي السليل الصناعي اليومي لبيانات التنقيح في الدرس الماضي.',
          en: 'Then time: modern teams respond within hours rather than days. When a change sits unreviewed for days, three bad things happen: the blocked author switches away and pays the context-switching cost later — or, worse, stacks new changes on the unreviewed one, so a found problem cascades; the change drifts out of date as the codebase moves and merge conflicts appear; and the author\u2019s memory of each decision fades, so their responses get vaguer. Speed does not mean carelessness: what squares the two is small changes — a 50-line change gets a genuinely careful read in minutes and turns around the same day, while 2,000 lines cannot be reviewed well or quickly: the reviewer skims, approves out of fatigue, and review becomes theater. Small, frequently reviewed changes are the industrialized everyday descendant of last lesson\u2019s inspection data: keep the chunk small, keep the reviewer engaged, and the defects surface.',
        },
      ],
    },
    {
      kind: 'worked',
      title: { ar: 'إحصاء زمن الانتظار: نبض مراجعة الفريق', en: 'Wait-time stats: the team\u2019s review pulse' },
      code: "waits = [2, 9, 1, 40, 3]\nwithin_day = 0\nfor w in waits:\n    if w <= 24:\n        within_day = within_day + 1\nprint('changes: %d' % len(waits))\nprint('reviewed within a day: %d' % within_day)\nprint('longest wait: %d' % max(waits))",
      explanation: {
        ar: 'التنقيح يقيس نفسه — والمراجعة اليومية فعل ذلك أيضًا. هذه القائمة ساعات انتظار خمسة تغييرات قبل أن يلتقطها مراجع: أربعة منها دُارت خلال يوم واحد، وواحد عطّل صاحبه أربعين ساعة كاملة — خلالها بنى فوقه وذاكرته بدت تتلاشى. تقرير من ثلاثة أسطر منسقة يقول للفريق أكثر من إحساس عام: أين نبض مراجعتنا؟ لو تكررت الأربعون أسبوعًا بعد أسبوع فالمشكلة ليست في مراجع مهمل بل في توزيع العمل أو حجم التغييرات. القياس يسبق العلاج.',
        en: 'An inspection measures itself — the everyday review does too. This list holds the hours five changes waited before a reviewer picked them up: four turned around within a day, while one left its author blocked for forty hours — during which they built on top of it and their memory of the decisions began to fade. A three-line formatted report tells the team more than a vibe: where is our review pulse? If the forty shows up week after week, the fix is not a careless reviewer but workload distribution or change size. Measurement precedes treatment.',
      },
    },
    {
      kind: 'exercise',
      id: 'ex1.comment-classifier',
      exKind: 'write_code',
      required: true,
      prompt: {
        ar: 'اتفقت فريقك على عقد تعليقات من ثلاث فئات: ما يبدأ بـ nit: فئة nit (ملاحظة شكلية اختيارية)، وما يبدأ بـ blocking: فئة blocking (عيب يوقف الدمج)، وما ينتهي بعلامة استفهام فئة question (سؤال عن النية)، وما عداهما فئة note. اكتب دالة classify(comment) تعيد اسم الفئة وفق هذه القواعد بالترتيب، ودالة classify_comments(comments) تعيد قاموس عدادات الفئات الأربعة مهيأة على الصفر وتعد كل تعليق في فئته، ثم اطبع أربع فئات بالترتيب: blocking ثم question ثم nit ثم note بصيغة فئة: عدد.',
        en: 'Your team agreed on a three-plus-one comment contract: anything starting with nit: is category nit (optional style remark), anything starting with blocking: is category blocking (merge-stopping defect), anything ending with a question mark is category question (an intent question), and the rest are note. Write classify(comment) returning the category name by those rules in order, and classify_comments(comments) returning a dict of the four counters pre-seeded at zero with every comment counted into its category; then print the four categories in order — blocking, question, nit, note — as category: count.',
      },
      starterCode: "COMMENTS = [\n    'nit: rename x to total',\n    'blocking: this drops the last item',\n    'does this handle the empty list?',\n    'nit: add a space after the comma',\n    'question: why 79 and not 88?',\n]\n\ndef classify(comment):\n    # nit: في البداية؟ blocking: في البداية؟ ينتهي بعلامة استفهام؟ وإلا note\n    # starts with nit:? starts with blocking:? ends with ?? otherwise note\n    return ''\n\ndef classify_comments(comments):\n    # أعد قاموسا بالعدادات الأربعة على الصفر ثم عدّ كل فئة\n    # return a dict with the four counters at zero, then count each category\n    return {}\n\ncounts = classify_comments(COMMENTS)\nfor k in ['blocking', 'question', 'nit', 'note']:\n    print('%s: %d' % (k, counts.get(k, 0)))\n",
      solution: "COMMENTS = [\n    'nit: rename x to total',\n    'blocking: this drops the last item',\n    'does this handle the empty list?',\n    'nit: add a space after the comma',\n    'question: why 79 and not 88?',\n]\n\ndef classify(comment):\n    if comment.startswith('nit:'):\n        return 'nit'\n    if comment.startswith('blocking:'):\n        return 'blocking'\n    if comment.endswith('?'):\n        return 'question'\n    return 'note'\n\ndef classify_comments(comments):\n    counts = {'nit': 0, 'blocking': 0, 'question': 0, 'note': 0}\n    for c in comments:\n        k = classify(c)\n        counts[k] = counts[k] + 1\n    return counts\n\ncounts = classify_comments(COMMENTS)\nfor k in ['blocking', 'question', 'nit', 'note']:\n    print('%s: %d' % (k, counts.get(k, 0)))",
      tests: [
        {
          id: 't1',
          name: { ar: 'العدادات الصحيحة لقائمة الفريق', en: 'Correct counters for the team list' },
          code: "assert classify_comments(COMMENTS) == {'nit': 2, 'blocking': 1, 'question': 2, 'note': 0}, 'expected: {nit: 2, blocking: 1, question: 2, note: 0} | actual: %r' % (classify_comments(COMMENTS),)",
          expected: '{nit: 2, blocking: 1, question: 2, note: 0}',
        },
        {
          id: 't2',
          name: { ar: 'قاعدة السؤال تعمل وحدها', en: 'The question rule works standalone' },
          code: "assert classify('does this handle the empty list?') == 'question', 'expected: question | actual: %r' % (classify('does this handle the empty list?'),)",
          expected: 'question',
        },
        {
          id: 't3',
          name: { ar: 'قاعدة البادئة تسبق غيرها', en: 'The prefix rules come first' },
          code: "assert classify('nit: rename x to total') == 'nit' and classify('blocking: this drops the last item') == 'blocking', 'expected: nit and blocking | actual: %r %r' % (classify('nit: rename x to total'), classify('blocking: this drops the last item'))",
          expected: 'nit and blocking',
        },
        {
          id: 't4',
          name: { ar: 'التقرير مطبوع منسقًا', en: 'The report is printed formatted' },
          code: "assert 'blocking: 1' in __learner_output__ and 'question: 2' in __learner_output__ and 'nit: 2' in __learner_output__, 'expected: blocking: 1, question: 2, nit: 2 | actual: %r' % __learner_output__",
          expected: 'blocking: 1, question: 2, nit: 2',
        },
      ],
      hints: [
        { ar: "startswith('nit:') تفحص بداية السلسلة وendswith('?') نهايتها — أدوات الفصل السادس تكفي كل العمل.", en: "startswith('nit:') checks the start of the string and endswith('?') its end — chapter 6 tools carry the whole job." },
        { ar: 'ترتيب الفحص جوهري: بادئة nit: أو blocking: تسقط قبل قاعدة الاستفهام — وإلا صار كل تعليق يبدأ بـ nit: وينتهي بعلامة استفهام سؤالًا.', en: 'Order matters: the nit:/blocking: prefixes are tested before the question rule — otherwise a comment starting with nit: and ending in ? would count as a question.' },
        { ar: 'هيكل classify_comments:\ncounts = {\'nit\': 0, \'blocking\': 0, \'question\': 0, \'note\': 0}\nfor c in comments:\n    k = classify(c)\n    counts[k] = counts[k] + 1\nreturn counts', en: "classify_comments skeleton:\ncounts = {'nit': 0, 'blocking': 0, 'question': 0, 'note': 0}\nfor c in comments:\n    k = classify(c)\n    counts[k] = counts[k] + 1\nreturn counts" },
        { ar: "الحل الكامل:\ndef classify(comment):\n    if comment.startswith('nit:'):\n        return 'nit'\n    if comment.startswith('blocking:'):\n        return 'blocking'\n    if comment.endswith('?'):\n        return 'question'\n    return 'note'", en: "Full solution:\ndef classify(comment):\n    if comment.startswith('nit:'):\n        return 'nit'\n    if comment.startswith('blocking:'):\n        return 'blocking'\n    if comment.endswith('?'):\n        return 'question'\n    return 'note'" },
      ],
    },
    {
      kind: 'exercise',
      id: 'ex2.trace-kind',
      exKind: 'trace_output',
      required: true,
      prompt: {
        ar: 'اقرأ الكود وتوقع خرجه بالضبط — سطر لكل طباعة — دون تشغيله. ركّز على أي قاعدة تلتقط كل تعليق.',
        en: 'Read the code and predict its exact output — one line per print — without running it. Focus on which rule catches each comment.',
      },
      code: "def kind(c):\n    if c.startswith('nit:'):\n        return 'nit'\n    if c.startswith('blocking:'):\n        return 'blocking'\n    return 'note'\n\nprint(kind('nit: spacing'))\nprint(kind('blocking: data loss'))\nprint(kind('looks right to me'))",
      solution: 'nit\nblocking\nnote',
