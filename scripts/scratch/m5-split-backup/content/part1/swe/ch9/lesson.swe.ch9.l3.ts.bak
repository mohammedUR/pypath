        { ar: 'ast.get_docstring(node) يعيد نص التوثيق أو None إن لم يوجد — فاختبار is None هو شرط المخالفة.', en: 'ast.get_docstring(node) returns the docstring text or None when absent — testing is None is the violation condition.' },
        { ar: 'الهيكل:\ntree = ast.parse(source)\nmissing = []\nfor node in ast.walk(tree):\n    if isinstance(node, ast.FunctionDef) and ast.get_docstring(node) is None:\n        missing.append(node.name)\nreturn missing', en: 'The skeleton:\ntree = ast.parse(source)\nmissing = []\nfor node in ast.walk(tree):\n    if isinstance(node, ast.FunctionDef) and ast.get_docstring(node) is None:\n        missing.append(node.name)\nreturn missing' },
        { ar: "الحل الكامل كما في المثال، مع node.name لاسم الدالة:\nmissing.append(node.name)", en: "Full solution as in the worked example, with node.name for the function name:\nmissing.append(node.name)" },
      ],
    },
    {
